        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공동인증서 전자서명"
          }
        }
      }
    },
    "DreamSecurity": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드림시큐리티"
          }
        }
      }
