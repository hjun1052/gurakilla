{
  "sourceLanguage": "en",
  "strings": {
    "%@ partly removed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 일부 제거됨"
          }
        }
      }
    },
    "%@ removed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 제거됨"
          }
        }
      }
    },
    "%@ · %@ · expires %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · 만료 %3$@"
          }
        }
      }
    },
    "%@: certificate backup is missing (%@).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 인증서 백업 파일이 없습니다(%2$@)."
          }
        }
      }
    },
    "%@: item is no longer in the Trash, or the original location is occupied.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 항목이 휴지통에 없거나 원래 위치에 이미 다른 항목이 있습니다."
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld item(s) will be moved to the Trash after stopping the software. Package receipts that are forgotten cannot be restored.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소프트웨어를 중지한 후 항목 %lld개를 휴지통으로 이동합니다. 삭제한 패키지 영수증은 복원할 수 없습니다."
          }
        }
      }
    },
    "%lld launchd job(s) will be unloaded and %lld process(es) asked to quit.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "launchd 작업 %1$lld개를 내리고 프로세스 %2$lld개에 종료를 요청합니다."
          }
        }
      }
    },
    "%lld process(es) did not respond to a graceful quit request: %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스 %1$lld개가 정상 종료 요청에 응답하지 않았습니다: %2$@."
          }
        }
      }
    },
    "%lld process(es) quit. Software set to start automatically will launch again at next login or restart.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스 %lld개를 종료했습니다. 자동 실행으로 설정된 소프트웨어는 다음 로그인이나 재시동 때 다시 실행됩니다."
          }
        }
      }
    },
    "%lld processes": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스 %lld개"
          }
        }
      }
    },
    "1 process": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스 1개"
          }
        }
      }
    },
    "A trusted root lets anything signed with its key appear secure to your browsers. It stays trusted after the software is gone unless removed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰된 루트 인증서가 있으면 그 키로 서명된 모든 것이 브라우저에서 안전하게 보입니다. 소프트웨어를 지워도 이 인증서를 제거하지 않으면 계속 신뢰됩니다."
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작"
          }
        }
      }
    },
    "Administrator authorization required": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 권한이 필요합니다"
          }
        }
      }
    },
    "Administrator steps were cancelled; only user-owned items were handled.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 단계가 취소되어 사용자 소유 항목만 처리했습니다."
          }
        }
      }
    },
    "Also unload disabled jobs now (stops them immediately)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끈 작업을 지금 내리기(즉시 중지)"
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용"
          }
        }
      }
    },
    "Apply %lld Changes": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항 %lld개 적용"
          }
        }
      }
    },
    "Apply 1 Change": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항 1개 적용"
          }
        }
      }
    },
    "Ask every detected program to quit": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지된 모든 프로그램에 종료 요청"
          }
        }
      }
    },
    "Ask the selected software to quit": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 소프트웨어에 종료 요청"
          }
        }
      }
    },
    "Audit Log": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감사 로그"
          }
        }
      }
    },
    "Auto-start": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 실행"
          }
        }
      }
    },
    "Auto-start disabled: %@/%@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 실행 끔: %1$@/%2$@"
          }
        }
      }
    },
    "Auto-start off": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 실행 꺼짐"
          }
        }
      }
    },
    "Auto-start on": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 실행 켜짐"
          }
        }
      }
    },
    "Before removal": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거 전"
          }
        }
      }
    },
    "Building removal plan…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거 계획을 만드는 중…"
          }
        }
      }
    },
    "CAs": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서"
          }
        }
      }
    },
    "CPU": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Certificate removed: %@ (%@)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서 제거됨: %1$@ (%2$@)"
          }
        }
      }
    },
    "Certificates": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서"
          }
        }
      }
    },
    "Change automatic startup": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 실행 변경"
          }
        }
      }
    },
    "Choose what launches automatically": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 실행할 항목 선택"
          }
        }
      }
    },
    "Choose which launchd jobs start automatically at login or boot. This is different from quitting: turning auto-start off prevents **future** launches but doesn't stop anything running now — unless you also unload the job below.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하거나 시동할 때 자동으로 실행할 launchd 작업을 고릅니다. 종료와는 다릅니다. 자동 실행을 끄면 **다음부터** 실행되지 않지만, 아래에서 작업을 함께 내리지 않으면 지금 실행 중인 것은 멈추지 않습니다."
          }
        }
      }
    },
    "Clearing certificate trust is guarded by macOS, which may ask for your password once more; the certificate is already deleted by then.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서 신뢰 해제는 macOS가 보호하므로 암호를 한 번 더 물을 수 있습니다. 그 시점에는 인증서가 이미 삭제되어 있습니다."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "Continue…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속…"
          }
        }
      }
    },
    "Could not change all jobs": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 작업을 변경하지 못했습니다"
          }
        }
      }
    },
    "Could not open uninstaller": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거 프로그램을 열 수 없습니다"
          }
        }
      }
    },
    "Detected": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지됨"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "Every change GuraKilla made is listed here. Auto-start changes are re-enabled in launchd; removed files are moved back from the Trash.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GuraKilla가 바꾼 모든 내용이 여기에 있습니다. 자동 실행 변경은 launchd에서 다시 켜고, 제거한 파일은 휴지통에서 원래 위치로 옮깁니다."
          }
        }
      }
    },
    "Extensions": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장 프로그램"
          }
        }
      }
    },
    "Files": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일"
          }
        }
      }
    },
    "Force Quit": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 종료"
          }
        }
      }
    },
    "Force quit processes": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스 강제 종료"
          }
        }
      }
    },
    "Force quitting (SIGKILL) stops the process immediately without letting it save state. These processes belong to another user and need administrator rights.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 종료(SIGKILL)는 상태를 저장할 틈 없이 프로세스를 즉시 멈춥니다. 이 프로세스는 다른 사용자 소유라 관리자 권한이 필요합니다."
          }
        }
      }
    },
    "GuraKilla": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GuraKilla"
          }
        }
      }
    },
    "GuraKilla hasn't changed anything yet.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GuraKilla가 아직 아무것도 바꾸지 않았습니다."
          }
        }
      }
    },
    "Inspector": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "속성"
          }
        }
      }
    },
    "Install location": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 위치"
          }
        }
      }
    },
    "Installed by the product's scripts": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제품의 설치 스크립트가 만든 파일"
          }
        }
      }
    },
    "Installed file": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 파일"
          }
        }
      }
    },
    "Invalid signature": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효하지 않은 서명"
          }
        }
      }
    },
    "It knows about every component, including kernel extensions and browser add-ons, and asks for authorization itself.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널 확장과 브라우저 부가 기능까지 모든 구성 요소를 알고 있으며, 권한도 직접 요청합니다."
          }
        }
      }
    },
    "Kernel extension · never removed by GuraKilla": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널 확장 · GuraKilla는 제거하지 않음"
          }
        }
      }
    },
    "Kernel extension — use the vendor uninstaller. GuraKilla never removes kernel extensions.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널 확장 — 제조사 제거 프로그램을 쓰세요. GuraKilla는 커널 확장을 제거하지 않습니다."
          }
        }
      }
    },
    "Launchd plist": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "launchd plist"
          }
        }
      }
